# =====================================================================
#  SMPP Bridge — environment template
#  Copy to .env and fill in real values.  NEVER commit the real .env.
# =====================================================================

# ---- ports ----
SMPP_PORT=2775
SMPP_HOST=0.0.0.0
ADMIN_PORT=3000
PORTAL_PORT=4000

# Public host shown to clients as their SMPP bind host
PUBLIC_HOST=your.server.host

# ---- QuickConnect vendor ----
# Needs login creds (mobile/email + password) to mint a Bearer JWT, plus the Api-Token.
QC_API_TOKEN=
QC_MOBILE=
QC_PASSWORD=
QC_EMAIL=

# ---- database ----
MONGO_URI=mongodb://127.0.0.1:27017/smpp_bridge
# Run with no MongoDB (in-memory, UI demo only): MOCK_DB=1

# ---- security ----
# Generate strong random values, e.g.  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
INTERNAL_KEY=change-me-to-a-long-random-string
ADMIN_EVENT_URL=http://127.0.0.1:3000/internal/event

DEFAULT_CURRENCY=EUR

# ---- Telegram operator control hub ----
TG_BOT_TOKEN=
TG_ADMIN_IDS=
