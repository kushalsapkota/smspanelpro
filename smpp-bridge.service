# cp *.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now smpp-bridge smpp-admin smpp-portal
[Unit]
Description=SMPP Bridge — SMPP server engine
After=network.target mongod.service
Wants=mongod.service
[Service]
Type=simple
WorkingDirectory=/root/bridge
ExecStart=/usr/bin/node /root/bridge/index.js
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
